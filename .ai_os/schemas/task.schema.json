{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "requirement_id", "goal", "files", "dependencies", "acceptance_criteria", "validation_gates", "owner", "max_token_budget", "retry_budget", "rollback_strategy", "confidence", "plan_version"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "requirement_id": { "type": "string" },
    "goal": { "type": "string" },
    "files": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "validation_gates": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["planned", "queued", "leased", "executing", "validating", "recovering", "blocked", "cancelled", "validated", "done"] },
    "owner": { "type": "string" },
    "max_token_budget": { "type": "integer", "minimum": 0 },
    "max_cost": { "type": "number", "minimum": 0 },
    "retry_budget": { "type": "integer", "minimum": 0 },
    "rollback_strategy": { "type": "string" },
    "context_pack_id": { "type": "string" },
    "validation_report_id": { "type": "string" },
    "completion_evidence": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_basis": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "string" } }
  }
}
