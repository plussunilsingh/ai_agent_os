{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryIndex",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "source_revision", "indexed_at", "scanner_version", "module_record_ids", "content_hash"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "source_revision": { "type": "string" },
    "indexed_at": { "type": "string", "format": "date-time" },
    "scanner_version": { "type": "string" },
    "module_record_ids": { "type": "array", "items": { "type": "string" } },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "skipped_paths": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
