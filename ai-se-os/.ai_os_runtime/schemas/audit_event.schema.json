{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEvent",
  "type": "object",
  "required": ["id", "schema_version", "event_type", "occurred_at", "repository_id", "correlation_id", "actor", "idempotency_key", "artifact_ids"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "event_type": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "repository_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "worktree_id": { "type": "string" },
    "branch": { "type": "string" },
    "session_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "actor": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "artifact_ids": { "type": "array", "items": { "type": "string" } },
    "policy_decision_id": { "type": "string" },
    "outcome": { "enum": ["success", "failure", "denied", "pending"] },
    "redacted_metadata": { "type": "object" }
  }
}
