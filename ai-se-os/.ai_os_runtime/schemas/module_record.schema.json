{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModuleRecord",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "path", "language", "hash", "dependencies", "exports", "confidence", "source_revision", "indexed_at"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "path": { "type": "string" },
    "language": { "type": "string" },
    "frameworks": { "type": "array", "items": { "type": "string" } },
    "hash": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "exports": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "symbols": { "type": "array", "items": { "type": "string" } },
    "apis": { "type": "array", "items": { "type": "string" } },
    "database_references": { "type": "array", "items": { "type": "string" } },
    "owners": { "type": "array", "items": { "type": "string" } },
    "technology_tags": { "type": "array", "items": { "type": "string" } },
    "build_references": { "type": "array", "items": { "type": "string" } },
    "package_references": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": { "type": "array", "items": { "type": "string" } },
    "source_revision": { "type": "string" },
    "indexed_at": { "type": "string", "format": "date-time" }
  }
}
