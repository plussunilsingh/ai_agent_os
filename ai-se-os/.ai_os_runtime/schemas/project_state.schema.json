{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectState",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "workspace_id", "worktree_id", "branch", "session_id", "observed_at", "facts"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "workspace_id": { "type": "string" },
    "worktree_id": { "type": "string" },
    "branch": { "type": "string" },
    "session_id": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "source", "observed_at", "ttl_seconds", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "value": {},
          "source": { "type": "string" },
          "observed_at": { "type": "string", "format": "date-time" },
          "ttl_seconds": { "type": "integer", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
