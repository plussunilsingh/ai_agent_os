{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringAssessment",
  "type": "object",
  "required": ["id", "schema_version", "requirement_id", "repository_id", "assessment_type", "conclusions", "assumptions", "unresolved_items", "evidence_ids", "risk", "complexity", "confidence", "producer", "published_at"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "requirement_id": { "type": "string" },
    "repository_id": { "type": "string" },
    "assessment_type": { "enum": ["completeness", "impact", "reasoning", "architecture", "risk", "complexity"] },
    "conclusions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "unresolved_items": { "type": "array", "items": { "type": "string" } },
    "affected_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "complexity": { "enum": ["small", "medium", "large", "unknown"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_basis": { "type": "array", "items": { "type": "string" } },
    "producer": { "type": "string" },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
