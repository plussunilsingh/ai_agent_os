{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionRecord",
  "type": "object",
  "required": ["id", "schema_version", "task_id", "attempt_id", "lease_id", "prompt_packet_id", "routing_decision_id", "policy_decision_id", "adapter", "repository_id", "source_revision", "status", "started_at", "touched_paths"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "task_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "lease_id": { "type": "string" },
    "prompt_packet_id": { "type": "string" },
    "routing_decision_id": { "type": "string" },
    "policy_decision_id": { "type": "string" },
    "adapter": { "type": "string" },
    "repository_id": { "type": "string" },
    "source_revision": { "type": "string" },
    "status": { "enum": ["running", "completed", "failed", "cancelled", "denied"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "touched_paths": { "type": "array", "items": { "type": "string" } },
    "tool_actions": { "type": "array", "items": { "type": "string" } },
    "log_uri": { "type": "string" },
    "error_summary": { "type": "string" },
    "output_artifact_ids": { "type": "array", "items": { "type": "string" } }
  }
}
