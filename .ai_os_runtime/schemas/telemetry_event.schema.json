{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryEvent",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "timestamp", "event_type", "metric_category"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "event_type": { "type": "string" },
    "task_id": { "type": "string" },
    "model": { "type": "string" },
    "input_tokens": { "type": "integer" },
    "output_tokens": { "type": "integer" },
    "cost": { "type": "number" },
    "status": { "type": "string" },
    "metadata": { "type": "object" },
    "metric_category": { "enum": ["repository", "context", "model", "execution", "validation", "recovery", "learning", "security", "cost", "benchmark"] },
    "metric_name": { "type": "string" },
    "target": { "type": "number" },
    "actual": { "type": "number" },
    "unit": { "type": "string" },
    "redaction_applied": { "type": "boolean" }
  }
}
