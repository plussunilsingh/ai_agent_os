{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextPack",
  "type": "object",
  "required": ["id", "schema_version", "repository_id", "task_id", "token_budget", "estimated_tokens", "items", "source_artifact_ids", "prompt_policy_decision_id", "content_hash"],
  "properties": {
    "id": { "type": "string" },
    "schema_version": { "type": "string" },
    "repository_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "task_id": { "type": "string" },
    "token_budget": { "type": "integer" },
    "estimated_tokens": { "type": "integer" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "content", "reason", "provenance", "source_version", "estimated_tokens"],
        "properties": {
          "kind": { "type": "string" },
          "content": { "type": "string" },
          "reason": { "type": "string" },
          "provenance": { "type": "string" },
          "rank": { "type": "number" },
          "source_version": { "type": "string" },
          "estimated_tokens": { "type": "integer", "minimum": 0 },
          "freshness": { "type": "string" },
          "sensitivity": { "type": "string" },
          "full_file_exception": { "type": "boolean" }
        }
      }
    },
    "omitted": { "type": "array", "items": { "type": "string" } },
    "source_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "prompt_policy_decision_id": { "type": "string" },
    "content_hash": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
